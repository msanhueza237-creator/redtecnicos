# Local review mode. No credentials are required with fixtures.
APP_DATA_SOURCE=fixtures
NEXT_PUBLIC_ENABLE_DEMO_PROFILES=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signed local role session. Enabled only while APP_DATA_SOURCE=fixtures.
DEMO_AUTH_ENABLED=true
# Optional locally; required with fixtures in production (32+ bytes).
DEMO_AUTH_SECRET=

# Dedicated Supabase environment only. Never reuse the currently shared stack.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Public form protection and operational email (future cycles).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# Required in staging/production once file uploads are enabled.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Deployment metadata.
DEPLOYMENT_ENV=development
APP_VERSION=0.1.0
BUILD_DATE=local
IP_HASH_SECRET=
