# Local review mode. No credentials are required with fixtures.
APP_DATA_SOURCE=fixtures
# Authentication can move to Supabase before public fixture data is migrated.
AUTH_DATA_SOURCE=fixtures
NEXT_PUBLIC_ENABLE_DEMO_PROFILES=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signed local role session. Enabled only while both sources use fixtures.
DEMO_AUTH_ENABLED=true
# Optional locally; required with fixtures in production (32+ bytes).
DEMO_AUTH_SECRET=

# Dedicated Supabase environment only. Never reuse the currently shared stack.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred for new Supabase installations. Self-hosted stacks may still use ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Public form protection and operational email.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_SECRET=
CONTACT_CONSENT_VERSION=privacy-v1
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Red Técnicos Chile
ADMIN_NOTIFICATION_EMAIL=

# Required in staging/production once file uploads are enabled.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Deployment metadata.
DEPLOYMENT_ENV=development
APP_VERSION=0.1.0
BUILD_DATE=local
